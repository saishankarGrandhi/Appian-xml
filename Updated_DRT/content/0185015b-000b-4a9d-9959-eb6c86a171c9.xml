    <rule>
        <name>CAW_QE_UpdateRotationAskDetailASKId</name>
        <uuid>0185015b-000b-4a9d-9959-eb6c86a171c9</uuid>
        <description>Updates each of the rotational ASK details ASK id </description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_forEach"(
  items: ri!rotationalAskDetail,
  expression: 
  updatedictionary(
    fv!item,
    {
      askId: ri!askId
    }
  )
)
</definition>
