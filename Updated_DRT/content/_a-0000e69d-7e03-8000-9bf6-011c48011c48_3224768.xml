    <rule>
        <name>CAW_returnStartProcessLinkForTasks</name>
        <uuid>_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224768</uuid>
        <description>rule to return start process link based on task type and status</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_startProcessLink"(
  processModel: if(
    ri!moduleName = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224774"[1],
    if(
      ri!requestType = #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3179825"[1],
      /*Core ASK*/
      if(
        contains(
          {
            #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3165924",
            #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3295646",
            #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3373079"
          },
          ri!taskStatusId
        ),
        if(
          ri!isAmend,
          #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3337119",
          #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224958"
        ),
        if(
          contains(
            {
              #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[1],
              #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[2],
              #"_a-0000e825-ace1-8000-9c24-011c48011c48_6791426"
            },
            ri!taskStatusId
          ),
          #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3192469",
          null
        )
      ),
      /* For rotational ASK*/
      if(
        contains(
          {
            #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3165924",
            #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3373079"
          },
          ri!taskStatusId
        ),
        if(
          ri!isAmend,
          #"_a-0000e6bc-0703-8000-9bf8-011c48011c48_3549439",
          #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3227079"
        ),
        if(
          contains(
            {
              #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[1],
              #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[2],
              #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[3],
              #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[4],
              #"_a-0000e825-ace1-8000-9c24-011c48011c48_6791426"
            },
            ri!taskStatusId
          ),
          #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3275391",
          null
        )
      )
    ),
    /*For nomination*/
    if(
      ri!moduleName = index(#"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224774",2,null),
      if(
        and(
          contains(
            {
              #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4570051",
              #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4558858",
              #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4570066",
              #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4489857",
              #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4489843",
              #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4576069"
            },
            tostring(ri!taskStatus)
          ),
          not(toboolean(ri!isTaskApproved) = true)
        ),
        #"_a-0000e6c1-137f-8000-9bf9-011c48011c48_3573702",
        if(
          contains(
            {
              #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4570086"
            },
            tostring(ri!taskStatus)
          ),
          #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3871982",
          if(
            contains(
              { 
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4558858",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4570977",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4571294",
                #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4472129",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4489843",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4489850",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4489857",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4488015",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4494081",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4576069"
              },
              tostring(ri!taskStatus)
            ),
            #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3874370",
            if(
              ri!taskStatus=#"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4573679",
              #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3956906",
              if(
                ri!taskStatus = #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4575806",
                #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4958580",
                if(
                  ri!taskStatus = #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4571729",
                  #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3947684",
                  if(
                    ri!taskStatus = #"_a-0000e7f4-9a94-8000-9c23-011c48011c48_6469940",
                    #"_a-0000e7f4-9a94-8000-9c23-011c48011c48_6469898",
                    if(
                      or(
                        ri!taskStatusId = #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3930284",
                        ri!taskStatusId = #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4966786",
                        ri!taskStatusId = #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4967023"
                      ),
                      #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4966723",
                      null
                    )
                  )
                )
              )
            )
          )
        )
      ),
      /*Replace the null for any other module*/
      null
    )
  ),
  processParameters: if(
    ri!moduleName = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224774"[1],
    if(
      ri!requestType = #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3179825"[1],
      {
        askId: ri!requestId,
        taskId: ri!taskId,
        isEdit: true,
        isTaskAmend: ri!isAmend
      },
      {
        askId: ri!requestId,
        taskId: ri!taskId,
        taskStatus: ri!taskStatus,
        isEdit: true,
        /*isTaskAmend: false,*/
        /*isInitialAmend: false,*/
        version: ri!version
      }
    ),
    if(
      ri!moduleName = index(#"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224774",2,null),
      {
        nominationId: ri!requestId,
        taskId: ri!taskId,
        taskStatus: ri!taskStatus,
        isEdit: true,
        taskStatusId: ri!taskStatusId
      },
      null
    )
  ),
  showWhen: contains(
    {
      #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224774"[1],
      #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3224774"[2]
    },
    ri!moduleName
  )
)</definition>
