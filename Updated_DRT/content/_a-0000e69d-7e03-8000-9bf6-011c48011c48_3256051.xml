    <versionUuid>_a-0000e825-ace1-8000-9c24-011c48011c48_6768794</versionUuid>
    <rule>
        <name>DEPRECATED_CAW_askMilestone</name>
        <uuid>_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256051</uuid>
        <description>rule to determine milestone for ASK</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!askType=#"_a-0000e676-ab43-8000-9bf5-011c48011c48_3163854",
  if(
    ri!hasBeenReturned,
    {
      "Open",
      "DPP Ops Review - Return",
      "NBL Review",
      "DPP Ops Review - Final",
      "DPP Leadership Review",
      "Completed"
    },
    {
      "Open", 
      "NBL Review",
      "DPP Ops Review - Final",
      "DPP Leadership Review",
      "Completed"
    }
  ),
  if(
    ri!hasBeenReturned,
    {
      "Open",
      "DPP Ops Review - Return",
      "NBL Review",
      "RPPP Review", 
      "DPP Leadership Review",
      "Completed"
    },
    {
      "Open",
      "NBL Review",
      "RPPP Review",
      "DPP Leadership Review",
      "Completed"
    }
  )
)</definition>
        <namedTypedValue>
            <name>askType</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>hasBeenReturned</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
