<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e825-ace1-8000-9c24-011c48011c48_6874361</versionUuid>
    <rule>
        <name>CAW_returnRotationalStatusId</name>
        <uuid>_a-0000e69d-7e03-8000-9bf6-011c48011c48_3277295</uuid>
        <description>rule to return next rotational status Id based on current status</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  /*If marked complete by dpp*/
  ri!isComplete = true,
  #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3344039",
  if(
    /*If group selected review will go to DPP Leadership*/
    #"_a-0000e375-1fcb-8000-daab-640000640000_930460"(ri!selectedLeadershipGroup),
    #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[2],
    if(
      /*If NMP review selected - review will go to NMP*/
      #"_a-0000e375-1fcb-8000-daab-640000640000_930460"(ri!selectedNMPGroup),
      #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[4],
      if(
        /* Initial, In progress , and returned requests go to PPL Review*/
        or(
          ri!isEdit = false,
          ri!taskStatusId = #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3165924",
          ri!taskStatusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3373079"
        ),
        #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[1],
        if(
          /*After PPL Review go to RPPP review*/
          ri!taskStatusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[1],
          #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[3],
          if(
            contains(
              {
                #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[2],
                #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[3],
                #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[4]
              },
              ri!taskStatusId
            ),
            #"_a-0000e825-ace1-8000-9c24-011c48011c48_6791426",
            #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3295646"
          )
        )
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>taskStatusId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isComplete</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>selectedLeadershipGroup</name>
            <type>
                <name>Group</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isEdit</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>selectedNMPGroup</name>
            <type>
                <name>Group</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
