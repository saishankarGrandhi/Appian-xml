    <versionUuid>_a-0000e69d-7e03-8000-9bf6-011c48011c48_3374334</versionUuid>
    <rule>
        <name>CAW_removeCAW</name>
        <uuid>_a-0000e69d-7e03-8000-9bf6-011c48011c48_3374322</uuid>
        <description>remove "CAW " to the front of a string</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  #"_a-0000e382-8b6f-8000-9ba2-011c48011c48_32623"(ri!selectedGroup),
  null,
  clean(replace(
    group(
      tointeger(ri!selectedGroup),
      "groupName"
    ),
    1,
    4,""
  ))
)</definition>
        <namedTypedValue>
            <name>selectedGroup</name>
            <type>
                <name>Group</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
