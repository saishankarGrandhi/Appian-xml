<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e6bc-0703-8000-9bf8-011c48011c48_3524158</versionUuid>
    <rule>
        <name>CAW_VerifyMaxRotationalASKCreated</name>
        <uuid>_a-0000e6b8-3009-8000-9bf7-011c48011c48_3440175</uuid>
        <description>Checks to see if the max 2 Rotational ASKs have been created for the current fiscal year</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!currentYear: year(today()),
  local!currentMonth : month(today()),
  local!isTodayNewFiscalYear: and(
    local!currentMonth &gt;= #"_a-0000e6b8-3009-8000-9bf7-011c48011c48_3440558",
    local!currentMonth &lt;= #"_a-0000e6bc-0703-8000-9bf8-011c48011c48_3457882"
  ),
  local!currentFiscalYear: if(
    local!isTodayNewFiscalYear,
    local!currentYear + 1,
    local!currentYear
  ),
  local!currentRotationalASKs: #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3127036"(
    fYear: local!currentFiscalYear,
    regionId: ri!regionId,
    returnCDT: true
  ),
  length(local!currentRotationalASKs) &gt;= #"_a-0000e6bc-0703-8000-9bf8-011c48011c48_3457928"
)</definition>
        <namedTypedValue>
            <name>regionId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
