<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6508919</versionUuid>
    <rule>
        <name>DEPRECATED_CAW_arrayPickerFilter</name>
        <uuid>_a-0000e6bc-0703-8000-9bf8-011c48011c48_3525627</uuid>
        <description>Rule to filter nominee for picker component</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!matches: where(
    #"SYSTEM_SYSRULES_forEach"(
      items: ri!labels, 
      expression: search( ri!filter, fv!item)
    )
  ),
  if(
    or(
      len(ri!filter) &gt;= ri!minSearchLen,
      isnull(ri!minSearchLen)
    ),
    #"SYSTEM_SYSRULES_dataSubset"(
      data: index(ri!labels, local!matches,null),
      identifiers: index(ri!identifiers, local!matches,null)
    ),
    #"SYSTEM_SYSRULES_dataSubset"(data: {}, identifiers: {})
  )
)</definition>
        <namedTypedValue>
            <name>labels</name>
            <type>
                <name>Text?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>identifiers</name>
            <type>
                <name>Text?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>filter</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>minSearchLen</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
