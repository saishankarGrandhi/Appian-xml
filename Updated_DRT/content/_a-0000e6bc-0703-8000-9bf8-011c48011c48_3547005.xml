        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049849</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_ButtonWidget"(
  label: #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3155721",
  value: #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3155721",
  saveInto: {
    ri!buttonValue,
    /* ask updates */
    a!save(ri!ask.statusId,#"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3373079"),
    a!save(ri!ask.modifiedBy, loggedInUser()),
    a!save(ri!ask.modifiedOn, now()),
    /* audit history */
    a!save(
      ri!auditHistory,
      'type!{urn:com:appian:types:CAW}CAW_Audit'(
        taskId: ri!task.taskId,
        requestId: ri!ask.askId,
        version: ri!task.version,
        moduleTypeId: #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3164387",
        statusId:  #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3373079",
        action: "Returned",
        description: if(
          ri!task.statusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[1],
          "Rotational ASK returned by PPL",
          if(
            ri!task.statusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[3],
            "Rotational ASK returned by APPP",
            if(
              ri!task.statusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[2],
              "Rotational ASK returned by DPP Leadership",
              if(
                ri!task.statusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[4],
                "Rotational ASK returned by DPP PIC",
                null
              )
            )
          )
        ),
        createdBy: loggedInUser(),
        createdOn: now()
      )
    ),
    /* task updates */
    a!save(ri!task.statusId,#"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3373079"),
    a!save(ri!task.assigneeId, ri!dppOPSReviewassigneeId),
    a!save(ri!task.isAssigneeGroup, tointeger(index(ri!dppOPSReviewAssignee, "totalCount",tointeger({}))) &gt; 1),
    a!save(ri!task.modifiedBy,loggedInUser()),
    a!save(ri!task.modifiedOn,now()),
    /*COMMENT LOGIC*/
    if(
      and(
        a!isNullOrEmpty(ri!previousComment),
        a!isNotNullOrEmpty(ri!comment.comment)
      ),
      /*Create the whole comment CDT*/
      a!save(
        ri!comment,
        'type!{urn:com:appian:types:CAW}CAW_Comment'(
          commentId: ri!comment.commentId,
          requestId: ri!ask.askId,
          moduleTypeId: #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3164387",
          comment: ri!comment.comment,
          isDraft: false,
          isActive: true,
          version: ri!task.version,
          createdBy: loggedInUser(),
          createdOn: now(),
          modifiedBy: loggedInUser(),
          modifiedOn: now()
        )
      ),
      if(
        and(
          a!isNotNullOrEmpty(ri!previousComment),
          a!isNullOrEmpty(ri!comment.comment)
        ),
        /*Clear the comment/Delete the row of data */
        a!save(ri!commentIDtoDelete, ri!comment.commentId),
        if(
          ri!comment.comment &lt;&gt; ri!previousComment,
          /*update the comment fields*/
          {
            a!save(ri!comment.modifiedBy, loggedInUser()),
            a!save(ri!comment.modifiedOn, now()),
            a!save(ri!comment.isDraft, false)
          },
          a!save(ri!comment.isDraft,false)
        )
      )
    )
  },
  submit: true,
  style: "DESTRUCTIVE",
  showWhen: and(
    ri!isReview,
    ri!task.statusId &lt;&gt; #"_a-0000e825-ace1-8000-9c24-011c48011c48_6791426"
  ),
  validate: true,
  disabled: a!isNullOrEmpty(ri!comment.comment),
  confirmMessage: "Are you sure you want to return this ASK to the DPP Review Editors?"
)</definition>
