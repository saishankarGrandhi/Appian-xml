            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!allASKsWithASKId: if(
    /*This means this is a CORE record*/
    ri!askTypeId = #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3163854",
    #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3235974"(
      askId: ri!askId,
      returnCDT: true
    ),
    /*This is rotational*/
    #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3338676"(
      askId: ri!askId,
      returnCDT: true
    )
  ),
  length(index(local!allASKsWithASKId, "askId", tointeger(null))) &gt; 1
)
</definition>
