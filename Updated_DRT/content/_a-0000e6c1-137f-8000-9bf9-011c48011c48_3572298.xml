    <rule>
        <name>CAW_UpdateAuditHistoryTaskId</name>
        <uuid>_a-0000e6c1-137f-8000-9bf9-011c48011c48_3572298</uuid>
        <description>Updates each of the audit history's Task IDs</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_forEach"(
  items: ri!auditHistory,
  expression: if(
    #"_a-0000e382-8b6f-8000-9ba2-011c48011c48_32623"(fv!item),
    {},
    updatedictionary(
      fv!item,
      {
        taskId: ri!taskId
      }
    )
  )
)
</definition>
        <namedTypedValue>
            <name>auditHistory</name>
            <type>
