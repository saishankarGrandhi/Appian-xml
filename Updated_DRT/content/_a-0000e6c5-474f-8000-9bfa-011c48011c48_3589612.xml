        saveAndExitToolTip: ri!saveAndExitToolTip,
        reviwercomment: ri!reviwercomment
      ),
      /*RETURN*/
      #"_a-0000e6ca-52ed-8000-9bff-011c48011c48_3715917"(
        nomination: ri!nomination,
        action: ri!action,
        task: ri!task,
        comment: ri!comment,
        auditHistory: ri!auditHistory,
        fullName: local!fullName,
        assignee: ri!assignee,
        showWhen: ri!isSubmit=false
      ),
      /*SUBMIT*/
      #"_a-0000e6c7-249e-8000-9bfe-011c48011c48_3643498"(
        nomination: ri!nomination,
        action: ri!action,
        task: ri!task,
        isEdit: ri!isEdit,
        comment: ri!comment,
        auditHistory: ri!auditHistory,
        fullName: local!fullName,
        isComplete: ri!isComplete ,
        nextStatusId: ri!nextStatusId ,
        assignee: ri!assignee,
        showWhen: ri!isSubmit,
        disabled: ri!disabled,
        isBasicApproval: ri!isBasicApproval,
        
      ),
      /*APPROVE*/
      #"_a-0000e6cf-8b0b-8000-9c00-011c48011c48_3748039"(
        nomination: ri!nomination,
        action: ri!action,
        task: ri!task,
        comment: ri!comment,
        auditHistory: ri!auditHistory,
        fullName: local!fullName,
        assignee: ri!assignee,
        showWhen: ri!isSubmit=false,
        isOpsAdditionalVettingReq: ri!isOpsAdditionalVettingReq,
        reviwercomment: ri!reviwercomment,
        
      )
    },
    secondaryButtons: {
      #"SYSTEM_SYSRULES_ButtonWidget"(
        label: "EXIT",
        submit: true,
        value: #"_a-0000e6c6-37ec-8000-9bfb-011c48011c48_3602779",
        saveInto: ri!action,
        validate: false,
