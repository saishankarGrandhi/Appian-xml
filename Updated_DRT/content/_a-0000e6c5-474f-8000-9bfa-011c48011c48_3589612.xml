      /*NOMINATION SAVE AND EXIT*/
      #"_a-0000e6c7-249e-8000-9bfe-011c48011c48_3642858"(
        nomination: ri!nomination,
        action: ri!action,
        task: ri!task,
        isEdit: ri!isEdit,
        comment: ri!comment,
