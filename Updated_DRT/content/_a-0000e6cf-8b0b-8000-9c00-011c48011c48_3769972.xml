<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e825-ace1-8000-9c24-011c48011c48_6768921</versionUuid>
    <interface>
        <name>CAW_CMP_ASKTabs</name>
        <uuid>_a-0000e6cf-8b0b-8000-9c00-011c48011c48_3769972</uuid>
        <description>Array of Buttons to display to toggle between tabs in the ASK forms</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049849</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_columnsLayout"(
  showWhen: ri!showWhen,
  columns:  {
    #"SYSTEM_SYSRULES_columnLayout"(
      contents: #"SYSTEM_SYSRULES_cardLayout"(
        contents: #"SYSTEM_SYSRULES_richTextDisplayField"(
          labelPosition: "COLLAPSED",
          value: {
            #"SYSTEM_SYSRULES_richTextIcon"(
              icon: "list-alt",
              color: if(
                ri!selectedTab = 1,
                "STANDARD",
                "SECONDARY"
              ),
              size: "MEDIUM"
            ),
            #"SYSTEM_SYSRULES_richTextItem_v1"(
              text: " Details",
              color: "ACCENT",
              size: "MEDIUM",
              style: if(
                ri!selectedTab = 1,
                "STRONG",
                "PLAIN"
              )
            )
          },
          align: "CENTER"
        ),
        link: #"SYSTEM_SYSRULES_dynamicLink"(
          value: 1,
          saveInto: ri!selectedTab
        ),
        style: if(
          ri!selectedTab = 1,
          "ACCENT",
          "NONE"
        ),
        showBorder: true
      ) 
    ),
    #"SYSTEM_SYSRULES_columnLayout"(
      showWhen: ri!isReview,
      contents: #"SYSTEM_SYSRULES_cardLayout"(
        contents: #"SYSTEM_SYSRULES_richTextDisplayField"(
          labelPosition: "COLLAPSED",
          value: {
            #"SYSTEM_SYSRULES_richTextIcon"(
              icon: "cloud-upload",
              color: if(
                ri!selectedTab = 2,
                "STANDARD",
                "SECONDARY"
              ),
              size: "MEDIUM"
            ),
            #"SYSTEM_SYSRULES_richTextItem_v1"(
              text: " Attachments",
              color: "ACCENT",
              size: "MEDIUM",
              style: if(
                ri!selectedTab = 2,
                "STRONG",
                "PLAIN"
              )
            )
          },
          align: "CENTER"
        ),
        link: #"SYSTEM_SYSRULES_dynamicLink"(
          value: 2,
          saveInto: ri!selectedTab
        ),
        style: if(
          ri!selectedTab = 2,
          "ACCENT",
          "NONE"
        ),
        showBorder: true
      ) 
    ),
    #"SYSTEM_SYSRULES_columnLayout"(
      showWhen: ri!previousCommentsShowWhen,
      contents: #"SYSTEM_SYSRULES_cardLayout"(
        contents: #"SYSTEM_SYSRULES_richTextDisplayField"(
          labelPosition: "COLLAPSED",
          value: {
            #"SYSTEM_SYSRULES_richTextIcon"(
              icon: "comments-o",
              color: if(
                ri!selectedTab = 3,
                "STANDARD",
                "SECONDARY"
              ),
              size: "MEDIUM"
            ),
            #"SYSTEM_SYSRULES_richTextItem_v1"(
              text: " Previous Comments",
              color: "ACCENT",
              size: "MEDIUM",
              style: if(
                ri!selectedTab = 3,
                "STRONG",
                "PLAIN"
              )
            )
          },
          align: "CENTER"
        ),
        link: #"SYSTEM_SYSRULES_dynamicLink"(
          value: 3,
          saveInto: ri!selectedTab
        ),
        style: if(
          ri!selectedTab = 3,
          "ACCENT",
          "NONE"
        ),
        showBorder: true
      )
    ),
    #"SYSTEM_SYSRULES_columnLayout"(),
    #"SYSTEM_SYSRULES_columnLayout"()
  },
  marginBelow: "STANDARD"
),</definition>
        <namedTypedValue>
            <name>selectedTab</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>showWhen</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>previousCommentsShowWhen</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>isReview</name>
            <type>
                <name>boolean</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>interface</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
        <isCustom>false</isCustom>
    </interface>
    <roleMap public="true">
        <role inherit="true" allowForAll="false" name="readers">
            <users/>
            <groups/>
        </role>
        <role inherit="true" allowForAll="false" name="authors">
            <users/>
            <groups/>
        </role>
        <role inherit="true" allowForAll="false" name="administrators">
            <users/>
            <groups/>
        </role>
        <role inherit="false" allowForAll="false" name="denyReaders">
            <users/>
            <groups/>
        </role>
        <role inherit="false" allowForAll="false" name="denyAuthors">
            <users/>
            <groups/>
        </role>
        <role inherit="false" allowForAll="false" name="denyAdministrators">
            <users/>
            <groups/>
        </role>
    </roleMap>
    <typedValue>
        <type>
            <name>RuleTestConfig?list</name>
            <namespace>http://www.appian.com/ae/types/2009</namespace>
        </type>
        <value>
            <el>
                <a:name/>
                <a:description/>
                <a:ruleInputTestConfigs>
                    <a:value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="a:Expression">1</a:value>
                    <a:nameRef>selectedTab</a:nameRef>
                    <a:id>1</a:id>
                </a:ruleInputTestConfigs>
                <a:ruleInputTestConfigs>
                    <a:value xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true" xsi:type="xsd:boolean"/>
                    <a:nameRef>showWhen</a:nameRef>
                    <a:id>2</a:id>
                </a:ruleInputTestConfigs>
                <a:ruleInputTestConfigs>
                    <a:value xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true" xsi:type="xsd:boolean"/>
                    <a:nameRef>previousCommentsShowWhen</a:nameRef>
                    <a:id>4</a:id>
                </a:ruleInputTestConfigs>
                <a:ruleInputTestConfigs>
                    <a:value xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xsd:boolean">false</a:value>
                    <a:nameRef>isReview</a:nameRef>
                    <a:id>5</a:id>
                </a:ruleInputTestConfigs>
                <a:assertions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
            </el>
        </value>
    </typedValue>
