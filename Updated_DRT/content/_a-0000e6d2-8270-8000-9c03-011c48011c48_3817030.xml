    <interface>
        <name>CAW_Interview</name>
        <uuid>_a-0000e6d2-8270-8000-9c03-011c48011c48_3817030</uuid>
        <description>interface for the interview view from a nomination form or nomination record</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049849</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>{
  if(
    and(
      ri!isUserDPPEditor,
      or(
        ri!nomination.isInterviewAvailabilityCompleted,
        ri!nomination.isOfficeVisitAvailabilityCompleted
      )
    ),
    #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4491142"(
      nomination: ri!nomination
    ),
    #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4452598"(
      nomination: ri!nomination,
      showWhen: or(
        ri!nomination.statusId = #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458932",
        ri!nomination.statusId = #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458889"
      )
    )
  ),
  if(
    or(
      ri!nomination.statusId = #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458932",
      ri!nomination.statusId = #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458889"
    ),
    /* CANDIDATE IS IN THE FORM */
    {},
    {
      /* SHOW THE REQUEST INTERVIEWS SECTION */
      if(
        and(
          ri!isUserDPPEditor,
          ri!nomination.isInterviewRequested = true,
          ri!interviewerTask &lt;&gt; true
        ),
        #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3890950"(ri!interviews),
        {}
      ),
      if(
        ri!interviewerTask,
        /* SHOW INTERVIEWER TASK */
        #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3856248"(
          interviews: ri!interviews,
          isInterviewerTask: true,
          showWhen: true,
          sectionLabel: "Interview"
        ),
        /* SHOW COMPLETED INTERVIEWS */
        #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3856248"(
          interviews: ri!completedInterviews,
          isInterviewerTask: false,
          showWhen: not(#"_a-0000e676-ab43-8000-9bf5-011c48011c48_3050228"(ri!completedInterviews)),
          sectionLabel: "Completed Interviews"
        )
      )
    }
  )
}</definition>
