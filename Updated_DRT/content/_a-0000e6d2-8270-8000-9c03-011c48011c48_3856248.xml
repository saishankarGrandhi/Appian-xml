        <name>CAW_CMP_InterviewReview</name>
        <uuid>_a-0000e6d2-8270-8000-9c03-011c48011c48_3856248</uuid>
        <description>read only interface for the interviews linked to a nomination</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049849</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!showInterview: repeat(count(ri!interviews),true),
  #"SYSTEM_SYSRULES_sectionLayout_v1"(
    label: ri!sectionLabel,
    labelColor: "SECONDARY",
    isCollapsible: true,
    contents: {
      #"SYSTEM_SYSRULES_forEach"(
        items: ri!interviews,
        expression: 
        #"SYSTEM_SYSRULES_cardLayout"(
          marginBelow: if(
            local!showInterview[fv!index],
            "STANDARD",
            "NONE"
          ),
          showBorder: false,
          contents: {
            #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3951709"(
              showInterview: local!showInterview,
              index: fv!index,
              isComplete: property(fv!item,"isComplete",false),
              interviewerName: index(fv!item,"interviewerFirstName","")&amp;char(32)&amp;index(fv!item,"interviewerLastName",""),
              isInterviewerTask: ri!isInterviewerTask
            ),
            #"SYSTEM_SYSRULES_cardLayout"(
              showWhen: local!showInterview[fv!index],
              showBorder: true,
              contents: {
                if(
                  ri!isInterviewerTask=true,
                  {
                    #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3858221"(fv!item),
                    #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3858241"(
                      interview: fv!item,
                      isInterviewerTask: true
                    )
                  },
                  #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3856291"(fv!item)
                )
              }
            )
          }
        )
      ),
      #"SYSTEM_SYSRULES_richTextDisplayField"(
        labelPosition: "COLLAPSED",
        value: {
          #"SYSTEM_SYSRULES_richTextItem_v1"(
            text: "No Interviews Found",
            style: "STRONG"
          )
        },
        showWhen: #"_a-0000e382-8b6f-8000-9ba2-011c48011c48_32623"(ri!interviews),
        align: "CENTER"
      )
    },
    showWhen: ri!showWhen
  )
)</definition>
