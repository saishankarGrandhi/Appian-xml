        <definition>#"SYSTEM_SYSRULES_sectionLayout_v1"(
  label: "Interviewer Feedback",
  labelColor: "SECONDARY",
  contents: {
    #"SYSTEM_SYSRULES_richTextDisplayField"(
      labelPosition: "COLLAPSED",
      value: #"SYSTEM_SYSRULES_richTextItem_v1"(
        text: "To be completed by Interviewer. Review attachments that are included in the Upload Attachments section.",
        style: "EMPHASIS"
      )
    ),
    #"SYSTEM_SYSRULES_radioButtonField"(
      label: "Are you supportive of the candidate being extended an offer for a DPP position?",
      choiceLabels: { "Yes", "No" },
      choiceValues: { true, false },
      choiceLayout: "COMPACT",
      disabled: not(ri!isInterviewerTask = true),
      required: ri!isInterviewerTask = true,
      value: ri!interview.supportExtensionOfOffer,
      saveInto: ri!interview.supportExtensionOfOffer
    ),
    #"SYSTEM_SYSRULES_paragraphField"(
      label: "Interview Feedback",
      characterLimit: #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3426796",
      disabled: not(ri!isInterviewerTask = true),
      required: ri!isInterviewerTask = true,
      value: ri!interview.interviewFeedback,
      saveInto: ri!interview.interviewFeedback
    ),
    #"SYSTEM_SYSRULES_radioButtonField"(
      label: "Do you recommend that the candidate interview with anyone else? If so, please specify who.",
      choiceLabels: { "Yes", "No" },
      choiceValues: { true, false },
      choiceLayout: "COMPACT",
      disabled: not(ri!isInterviewerTask = true),
      required: ri!isInterviewerTask = true,
      value: ri!interview.recommendAnotherInterview,
      saveInto: ri!interview.recommendAnotherInterview
    ),
    #"SYSTEM_SYSRULES_paragraphField"(
      label: "Provide Name(s)",
      height: "SHORT",
      characterLimit: 1000,
      disabled: not(ri!isInterviewerTask = true),
      required: and(
        ri!isInterviewerTask = true,
        ri!interview.recommendAnotherInterview = true
      ),
      value: ri!interview.recommendAnotherInterviewDesc,
      saveInto: ri!interview.recommendAnotherInterviewDesc
    )
  }
)</definition>
