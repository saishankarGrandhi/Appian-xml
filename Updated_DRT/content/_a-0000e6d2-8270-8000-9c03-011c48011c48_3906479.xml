<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e6d2-8270-8000-9c03-011c48011c48_3975703</versionUuid>
    <rule>
        <name>CAW_CancelNominationInterviews</name>
        <uuid>_a-0000e6d2-8270-8000-9c03-011c48011c48_3906479</uuid>
        <description>Cancels all active interviews when a nomination is cancelled</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!interviews: #"_a-0000e6bc-0703-8000-9bf8-011c48011c48_3499144"(
    nominationId: ri!nominationId,
    isComplete:  false,
    isCancelled: false,
    returnCDT: true
  ),
  if(
    #"_a-0000e382-8b6f-8000-9ba2-011c48011c48_32623"(local!interviews),
    null,
    #"SYSTEM_SYSRULES_forEach"(
      items: local!interviews,
      expression:  updatedictionary(
        fv!item,
        {
          isCancelled: true,
          isComplete: false,
          isActive: false,
          modifiedBy: #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3052910"(loggedInUser()),
          modifiedOn: now()
        }
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>nominationId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
        <role inherit="true" allowForAll="false" name="readers">
            <users/>
            <groups/>
        </role>
        <role inherit="true" allowForAll="false" name="authors">
            <users/>
            <groups/>
        </role>
        <role inherit="true" allowForAll="false" name="administrators">
            <users/>
