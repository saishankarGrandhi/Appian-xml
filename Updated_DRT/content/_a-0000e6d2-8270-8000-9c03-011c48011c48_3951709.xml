    <interface>
        <name>CAW_CMP_InterviewHeader</name>
        <uuid>_a-0000e6d2-8270-8000-9c03-011c48011c48_3951709</uuid>
        <description>the cardlayout that holds the interview component header</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049849</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_cardLayout"(
  style: "STANDARD",
  padding: "EVEN_LESS",
  marginBelow: "NONE",
  contents: #"SYSTEM_SYSRULES_richTextDisplayField"(
    value: {
      #"SYSTEM_SYSRULES_richTextIcon"(
        icon: if(
          index(ri!showInterview,ri!index,toboolean(null)) = true,
          "chevron-down",
          "chevron-right"
        ),
        size: "MEDIUM",
        linkStyle: "STANDALONE",
        link: #"SYSTEM_SYSRULES_dynamicLink"(
          saveInto: {
            a!save(
              ri!showInterview[ri!index],
              not(index(ri!showInterview,ri!index))
            )
          }
        ) 
      ),
      char(32),
      #"SYSTEM_SYSRULES_richTextItem_v1"(
        text: if(
          ri!isComplete,
          "Completed - "&amp;ri!interviewerName,
          if(
            ri!isInterviewerTask,
            "To Do - "&amp;ri!interviewerName,
            "In Progress - "&amp;ri!interviewerName
          )
        ),
        size: "MEDIUM",
        style: "STRONG"
      )
    }
  ),
  link: #"SYSTEM_SYSRULES_dynamicLink"(
    saveInto: {
      a!save(
        ri!showInterview[ri!index],
        not(index(ri!showInterview,ri!index))
      )
    }
  ) 
)</definition>
        <namedTypedValue>
            <name>showInterview</name>
            <type>
