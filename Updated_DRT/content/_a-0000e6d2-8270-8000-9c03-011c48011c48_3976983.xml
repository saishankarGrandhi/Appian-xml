        <name>DEPRECATED_CAW_createSiteUrlForRecord</name>
        <uuid>_a-0000e6d2-8270-8000-9c03-011c48011c48_3976983</uuid>
        <description></description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!url: #"urn:appian:function:v1:fn:urlforrecord?okey=urlforrecord"(recordType: ri!recordType, recordIds: ri!recordId),
  substitute(
    local!url,
    "tempo/records/item",
    concat(
      "sites/",
      ri!siteWebAddressIdentifier,
      "/page/",
      ri!sitePage,
      "/record"
    )
  )
)</definition>
        <namedTypedValue>
            <name>siteWebAddressIdentifier</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>sitePage</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>recordId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>recordType</name>
            <type>
                <name>RecordType2</name>
