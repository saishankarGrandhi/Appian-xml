    <rule>
        <name>CAW_createSiteUrl</name>
        <uuid>_a-0000e6d2-8270-8000-9c03-011c48011c48_3977150</uuid>
        <description>gives url for site for the current environment</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>concat(
  index(
    split(
      #"urn:appian:function:v1:fn:urlforrecord?okey=urlforrecord"(#"urn:appian:record-type:v1:SYSTEM_RECORD_TYPE_USER"),
      "tempo"
    ),
    1,
    null
  ),
  "sites/",
  ri!siteWebAddressIdentifier
)</definition>
        <namedTypedValue>
            <name>siteWebAddressIdentifier</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
