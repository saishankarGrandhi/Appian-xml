    <versionUuid>_a-0000e72d-09a6-8000-9c0e-011c48011c48_4559526</versionUuid>
    <rule>
        <name>CAW_VerifyReviewOptionsToDisable</name>
        <uuid>_a-0000e723-cc8a-8000-9c0d-011c48011c48_4472947</uuid>
        <description></description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!allReviews: #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4472370",
  local!allReviewsRemoved: remove(
    local!allReviews,
    wherecontains(
      ri!currentReview,
      local!allReviews
    )
  ),
  local!allReviewsList: #"SYSTEM_SYSRULES_forEach"(
    items: local!allReviewsRemoved,
    expression: index(ri!nomination, fv!item,toboolean({}))
  ),
  /*and(*/
/*    */
    /*index(ri!nomination,ri!currentReview,null) = false */
  /*)*/
  contains(
    local!allReviewsList,
    true
  )
)</definition>
        <namedTypedValue>
            <name>nomination</name>
            <type>
                <name>CAW_Nomination</name>
                <namespace>urn:com:appian:types:CAW</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>currentReview</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
