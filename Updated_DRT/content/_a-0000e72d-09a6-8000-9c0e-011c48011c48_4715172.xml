    <rule>
        <name>CAW_formatEmailSubject</name>
        <uuid>_a-0000e72d-09a6-8000-9c0e-011c48011c48_4715172</uuid>
        <description>Rule to format email subject</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4717821" = #"_a-0000e790-a118-8000-9c1b-011c48011c48_5604382",
  concat(
    ri!subject,
    " - ",
    ri!lastName,
    ", ",
    ri!firstName,
    if(
      len(ri!middleName)&gt;0,
      " " &amp; left(ri!middleName,1),
      null
    )
  ),
  concat(
    #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4717821",
    " - ",
    ri!subject,
    " - ",
    ri!lastName,
    ", ",
    ri!firstName,
    if(
      len(ri!middleName)&gt;0,
      " " &amp; left(ri!middleName,1),
      null
    )
  )
)</definition>
        <namedTypedValue>
            <name>subject</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>firstName</name>
            <type>
