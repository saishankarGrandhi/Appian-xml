    <versionUuid>_a-0000e825-ace1-8000-9c24-011c48011c48_6929501</versionUuid>
    <rule>
        <name>CAW_formatEmailRecipientName</name>
        <uuid>_a-0000e72d-09a6-8000-9c0e-011c48011c48_4719289</uuid>
        <description>Rule to format email recipient name</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  contains(
    {
      #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4577779"
    },
    ri!statusId
  ),
  "Operations Team",
  if(
    contains(
      {
        #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458947",
        #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458895",
        #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4578520",
        #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4489118",
        #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4578617",
        #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3935295",
        #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3930284",
        #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4967023",
        #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4494074"
      },
      ri!statusId
    ),
    ri!recipientName,
    if(
      contains(
        { #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3935288",
        #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3927661",
        #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4966786",
        #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458889",
        #"_a-0000e723-cc8a-8000-9c0d-011c48011c48_4458932"
        },
        ri!statusId
      ),
      concat(
        ri!firstName,
        if(
          len(ri!middleName)&gt;0,
          " " &amp; left(ri!middleName,1),
          null
        ),
        " ",
        ri!lastName
      ),
      if(
        ri!statusId = #"_a-0000e6eb-1d17-8000-9c08-011c48011c48_4183431",
        if(
          ri!selectedGroup = #"_a-0000e825-ace1-8000-9c24-011c48011c48_6801187",
          #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3052910"(ri!selectedBuGroup),
          if(
            #"_a-0000e382-8b6f-8000-9ba2-011c48011c48_32623"(ri!selectedBuGroup),
            ri!selectedGroup,
            ri!selectedBuGroup
          )
        ),
        null
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>recipientName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>statusId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>firstName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>middleName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>lastName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>selectedGroup</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>selectedBuGroup</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
