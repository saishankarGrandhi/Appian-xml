        <name>CAW_determineEmailTriggerIdForCandidateIntake</name>
        <uuid>_a-0000e72d-09a6-8000-9c0e-011c48011c48_5237528</uuid>
        <description>Determine whether email notification should be addressed to candidate or dpp ops</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  /*If status is Candidate Information Intake Sent */
  ri!taskId = #"_a-0000e6c7-249e-8000-9bfe-011c48011c48_3622146"[12],
  #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_5211801",
  if(
   /* If status is Candidate Information Intake Complete */
    ri!taskId = #"_a-0000e6c7-249e-8000-9bfe-011c48011c48_3622146"[13],
    #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_5211826",
    null
  )
)</definition>
        <namedTypedValue>
            <name>taskId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
