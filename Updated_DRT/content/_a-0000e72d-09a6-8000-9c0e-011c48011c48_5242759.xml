    <rule>
        <name>CAW_coreASKExportLogicalExpression</name>
        <uuid>_a-0000e72d-09a6-8000-9c0e-011c48011c48_5242759</uuid>
        <description>Logical Expression for core ASK export</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>#"SYSTEM_SYSRULES_queryLogicalExpression"(
  ignorefilterswithemptyvalues: true,
  operator: "AND",
  filters: {
    #"SYSTEM_SYSRULES_queryFilter"(
      field: "fYear",
      operator: "in",
      value: ri!yearFilter
    ),
    #"SYSTEM_SYSRULES_queryFilter"(
      field: "dppGroup",
      operator: "in",
      value: ri!dppGroup
    ),
    #"SYSTEM_SYSRULES_queryFilter"(
      field: "levelNeed",
      operator: "in",
      value: ri!level
    ),
    #"SYSTEM_SYSRULES_queryFilter"(
      field: "generalSpecialityNeed",
      operator: "in",
      value: ri!speciality
    ),
    #"SYSTEM_SYSRULES_queryFilter"(
      field: "needReason",
      operator: "in",
      value: ri!reason
    ),
    #"SYSTEM_SYSRULES_queryFilter"(
      field: "status",
      operator: "in",
      value: ri!askStatus
    ),
    #"SYSTEM_SYSRULES_queryFilter"(
      field: "askDetailId",
      operator: "in",
      value: ri!askDetailId
    ),
  }
)</definition>
        <namedTypedValue>
