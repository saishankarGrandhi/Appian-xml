    <versionUuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6549415</versionUuid>
    <rule>
        <name>CAW_getReminderAddressee</name>
        <uuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6528058</uuid>
        <description>Returns the proper addressee for reminder emails</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!recipient = #"_a-0000e72d-09a6-8000-9c0e-011c48011c48_4718496",
  "Operations Team",
  if(
    isusernametaken(ri!recipient),
    user(ri!recipient, "firstName") &amp; " " &amp; user(ri!recipient, "lastName"),
    ri!recipient
  )
)</definition>
        <namedTypedValue>
            <name>recipient</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
