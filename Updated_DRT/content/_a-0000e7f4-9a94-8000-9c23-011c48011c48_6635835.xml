<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6635857</versionUuid>
    <rule>
        <name>CAW_formatZeroForReports</name>
        <uuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6635835</uuid>
        <description>When input is 0 or null, return "-".</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  or(
    a!isNullOrEmpty(ri!value),
    ri!value = 0
  ),
  "-",
  ri!value
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
