<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6662007</versionUuid>
    <rule>
        <name>CAW_formatVarianceForReports</name>
        <uuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6636024</uuid>
        <description>If value is less than zero, return "(value)", if value is zero return "-", if value is greater than zero return value</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  or(
    a!isNullOrEmpty(ri!value),
    ri!value = 0
  ),
  "-",
  if(
    ri!value &lt; 0,
    "("&amp;abs(ri!value)&amp;")",
    ri!value
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
