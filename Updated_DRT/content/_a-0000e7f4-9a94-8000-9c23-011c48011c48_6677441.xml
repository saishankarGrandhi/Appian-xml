<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6677818</versionUuid>
    <rule>
        <name>CAW_formatNominationName</name>
        <uuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6677441</uuid>
        <description>Expression to format the task/nomination header/name</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>concat(
  {
    if(
      ri!nominationTypeId = #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3868562",
      #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3934538"[2],
      if(
        a!isNullOrEmpty(ri!originatingBU),
        "Direct Hire",
        ri!originatingBU
      )
    ),
    " : ",
    charat(ri!firstName,1),
    " ",
    ri!lastName
  }
)</definition>
        <namedTypedValue>
            <name>nominationTypeId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>originatingBU</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>firstName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <namedTypedValue>
            <name>lastName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
