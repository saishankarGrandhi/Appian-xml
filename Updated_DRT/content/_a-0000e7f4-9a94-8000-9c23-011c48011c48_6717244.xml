    <rule>
        <name>CAW_getGroupsForUsers</name>
        <uuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6717244</uuid>
        <description>rule to get a list of groups for users where they are direct members</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!results: if(
    #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3050228"(ri!groups),
    {},
    #"SYSTEM_SYSRULES_forEach"(
      items: ri!groups,
      expression: a!localVariables(
        local!updatedGroup: #"425ed4f5-d41e-4c05-9118-bc2495f87429"(oldGroups:tostring(group(fv!item, "groupName"))),
        if(
          left(group(fv!item, "groupName"), 3) = "CAW",
          if(
            contains(
              touniformstring(
                a!groupMembers(group: fv!item, direct: true).data
              ),
              ri!user
            ),
            if(
              a!isNullOrEmpty(local!updatedGroup),
              touniformstring(group(fv!item, "groupName")),
              #"SYSTEM_SYSRULES_forEach"(
                togroup(
                  local!updatedGroup
                ),
                group(fv!item, "groupName")
              )
            ),
            {}
          ),
          {}
        )
      )
    )
  ),
 
  reject(
    fn!isnull,
    {#"_a-0000ea45-eea9-8000-9c49-011c48011c48_11617061"(a!flatten(local!results))}
    )
  
)</definition>
        <namedTypedValue>
            <name>groups</name>
            <type>
                <name>Group?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <namedTypedValue>
            <name>user</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
