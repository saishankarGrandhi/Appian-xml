<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000e825-ace1-8000-9c24-011c48011c48_6952182</versionUuid>
    <rule>
        <name>CAW_calculateFiscalYearDropdown</name>
        <uuid>_a-0000e7f4-9a94-8000-9c23-011c48011c48_6751857</uuid>
        <description>Expression rule to calculate the values for the fiscal year filter dropdowns</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!startFiscalYear: 2022,
  local!currentFiscalYear: #"_a-0000e6d2-8270-8000-9c03-011c48011c48_3953700"(),
  local!fiscalYearDropdown: if(
    local!startFiscalYear = local!currentFiscalYear,
    {local!currentFiscalYear},
    tointeger(
      local!startFiscalYear,
      #"SYSTEM_SYSRULES_forEach"(
        items: enumerate(local!currentFiscalYear - local!startFiscalYear) + 1,
        expression: local!startFiscalYear + fv!item
      )
    )
  ),
  local!fiscalYearDropdown
)</definition>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
    <roleMap public="true">
