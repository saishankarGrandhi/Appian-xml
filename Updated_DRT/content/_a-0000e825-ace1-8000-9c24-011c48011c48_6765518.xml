        <definition>#"SYSTEM_SYSRULES_queryLogicalExpression"(
  ignorefilterswithemptyvalues: true,
  operator: "AND",
  logicalexpressions: {
    #"SYSTEM_SYSRULES_queryLogicalExpression"(
      operator: "AND",
      ignorefilterswithemptyvalues: true,
      filters: {
        #"SYSTEM_SYSRULES_queryFilter"(
          field: "fullName",
          operator: "in",
          value: ri!nameFilter
        ),
        #"SYSTEM_SYSRULES_queryFilter"(
          field: "fiscalYear",
          operator: "in",
          value: ri!yearFilter
        )
      }
    )
  }
)</definition>
        <namedTypedValue>
            <name>nameFilter</name>
            <type>
