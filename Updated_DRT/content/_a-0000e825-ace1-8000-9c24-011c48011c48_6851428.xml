    <rule>
        <name>CAW_returnNextCoreAssigneeGroup</name>
        <uuid>_a-0000e825-ace1-8000-9c24-011c48011c48_6851428</uuid>
        <description>returns the next assignee group for the core ask based of the next status id</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!taskStatusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[1],
  {
    #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3177083",
    /*cons!CAW_GRP_PPL_DELEGATE_ALL,*/
    /*cons!CAW_GRP_PPL_DELEGATE_MD_ROTATIONAL*/
  },
  if(
    contains(
      {
        #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3295646",
        #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3373079",
        #"_a-0000e825-ace1-8000-9c24-011c48011c48_6791426"
      },
      ri!taskStatusId
    ),
    #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3174922",
    if(
      ri!taskStatusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3256063"[2],
      #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3176497",
      if(
        ri!taskStatusId = #"_a-0000e69d-7e03-8000-9bf6-011c48011c48_3344039",
        null,
        #"_a-0000e676-ab43-8000-9bf5-011c48011c48_3174770"
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>taskStatusId</name>
            <type>
                <name>int</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
        </namedTypedValue>
