            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  ri!level = "P",
  {
    #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948831", 
    #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948843"
  },
  if(
    ri!level = "MD",
    {
      #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948850"
    },
    if(
      ri!level = "SM",
      {
        #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948928"
      },
      if(
        ri!level = "AD-ED",
        {
          #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948857", 
          #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948900", 
          #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948907", 
          #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948914"
        },
        if(
          ri!level = "M",
          {
            #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948935"
          },
          if(
            ri!level = "SA",
            {
              #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948942"
            },
            if(
              ri!level = "A",
              {
                #"_a-0000e825-ace1-8000-9c24-011c48011c48_6948955"
              },
              {}
            )
          )
        )
      )
    )
  )
)</definition>
