    <rule>
        <name>CAW_getDPPLevelIdsForLevelCategory</name>
        <uuid>_a-0000e825-ace1-8000-9c24-011c48011c48_6911879</uuid>
        <description>Rule to get specific DPP level IDs based on level category name</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
