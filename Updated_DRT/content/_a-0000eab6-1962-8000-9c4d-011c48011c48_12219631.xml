    <rule>
        <name>CAW_isBlankOrEmpty</name>
        <uuid>_a-0000eab6-1962-8000-9c4d-011c48011c48_12219631</uuid>
        <description>Expression rule to check null values</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>or(
  ri!data ="", 
  isnull(ri!data ),
  if(fn!isnull(ri!data),true(),length(ri!data)=0)
)</definition>
        <namedTypedValue>
            <name>data</name>
            <type>
                <name>Variant</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
