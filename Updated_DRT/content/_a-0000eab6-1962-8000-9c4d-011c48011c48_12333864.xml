        <definition>reject(
  fn!isnull,
  a!localVariables(
    local!dataSubset: todatasubset(ri!userUploadedData),
    local!data: #"SYSTEM_SYSRULES_forEach"(
      local!dataSubset,
      if(
        index(fv!item, "userAction", null) = ri!action,
        fv!item,
        null
      )
    ),
    local!data
  )
)</definition>
