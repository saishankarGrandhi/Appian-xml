    <rule>
        <name>CAW_validateName</name>
        <uuid>_a-0000eab6-1962-8000-9c4d-011c48011c48_12334255</uuid>
        <description>Rule to validate the frst and last name entered while creating users</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>if(
  #"_a-0000eab6-1962-8000-9c4d-011c48011c48_12219631"(trim(ri!value)),
  "Please enter valid details",
  if(
    len(
      cleanwith(ri!value, #"_a-0000eab6-1962-8000-9c4d-011c48011c48_12334262")
    ) = len(ri!value),
    if(
      len(
        cleanwith(ri!value, #"_a-0000eab6-1962-8000-9c4d-011c48011c48_12334269")
      ) = len(ri!value),
      "Only numbers not allowed",
      null
      
    ),
    "Special characters not Allowed. (Only letters, _ , - are allowed)"
  )
)</definition>
        <namedTypedValue>
            <name>value</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
