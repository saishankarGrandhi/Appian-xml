    <rule>
        <name>PE_SFTP_returnFilesForDate</name>
        <uuid>_a-0000eb38-82c9-8000-9c51-011c48011c48_12461195</uuid>
        <description>From list of file names, returns names for given date</description>
        <parentUuid>29a5d1a0-0cee-4539-9a25-a36937648dd0</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!dateString: if(
    #"_a-0000eb38-82c9-8000-9c51-011c48011c48_12461260"(ri!date),
    {},
    text(ri!date, "YYYY-MM-DD")
  ),
  reject(
    #"_a-0000eb38-82c9-8000-9c51-011c48011c48_12461260",
    #"SYSTEM_SYSRULES_forEach"(
      items: ri!fileNames,
      expression: if(
        search(local!dateString, fv!item)=0,
        null,
        fv!item
      )
    )
  )
)</definition>
        <namedTypedValue>
            <name>date</name>
            <type>
                <name>date</name>
