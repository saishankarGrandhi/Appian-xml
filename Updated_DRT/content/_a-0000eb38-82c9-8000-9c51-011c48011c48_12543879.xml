    <rule>
        <name>PE_SFTP_getProcessTypeByFileName</name>
        <uuid>_a-0000eb38-82c9-8000-9c51-011c48011c48_12543879</uuid>
        <description>using file name get relevant process type with details</description>
        <parentUuid>29a5d1a0-0cee-4539-9a25-a36937648dd0</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!processTypes: cast(
    typeof({'type!{urn:com:appian:types:PE}PE_SFTP_REF_PROCESS_TYPES'()}),
    #"SYSTEM_SYSRULES_queryEntity_v2"(
      entity: #"_a-0000eb38-82c9-8000-9c51-011c48011c48_12544241",
      query: #"SYSTEM_SYSRULES_query"(
        paginginfo: #"SYSTEM_SYSRULES_pagingInfo"(
          startIndex: 1,
          batchSize: -1
        )
      ),
      fetchtotalcount: false
    ).data
  ),
  reduce(
    #"_a-0000eb38-82c9-8000-9c51-011c48011c48_12543886"(
      fileName: ri!fileName,
      currentValue:_,
      processType: _
    ),
    null,
    local!processTypes
  )
)</definition>
        <namedTypedValue>
            <name>fileName</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
