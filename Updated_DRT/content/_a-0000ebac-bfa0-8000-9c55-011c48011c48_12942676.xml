<contentHaul xmlns:a="http://www.appian.com/ae/types/2009">
    <versionUuid>_a-0000ebac-bfa0-8000-9c55-011c48011c48_12944564</versionUuid>
    <rule>
        <name>DRTV4_formatEmailIds</name>
        <uuid>_a-0000ebac-bfa0-8000-9c55-011c48011c48_12942676</uuid>
        <description>Rule to format email IDs ( comma separated) to send email</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!emailIds: split(stripwith(ri!emailId_string, " "), ","),
  remove(
    touniformstring(local!emailIds),
    wherecontains("", touniformstring(local!emailIds))
  )
)</definition>
        <namedTypedValue>
            <name>emailId_string</name>
            <type>
                <name>Text?list</name>
                <namespace>http://www.appian.com/ae/types/2009</namespace>
            </type>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
