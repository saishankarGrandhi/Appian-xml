    <rule>
        <name>DRTv4_getCawGroupsForUsers</name>
        <uuid>_a-0000ebac-bfa0-8000-9c55-011c48011c48_12959422</uuid>
        <description>rule to get a list of groups for users where they are members</description>
        <parentUuid>_a-0000e676-ab43-8000-9bf5-011c48011c48_3049803</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>a!localVariables(
  local!isUserActive: isuseractive(ri!user),
  local!allUserGroups: if(
    toboolean(local!isUserActive),
    getgroupsformemberuser(touser(ri!user)),
    {}
  ),
  local!existingUserGroups: #"SYSTEM_SYSRULES_forEach"(
    items: local!allUserGroups,
    expression: {
      if(
        or(
          left(group(fv!item, "groupName"), 3) = "CAW",
          left(group(fv!item, "groupName"), 3) = "DRT"
        ),
        fv!item,
        null
      )
    }
  ),
  if(a!isNullOrEmpty(local!existingUserGroups),null,reject(fn!isnull,local!existingUserGroups))
)</definition>
        <namedTypedValue>
            <name>user</name>
            <type>
                <name>string</name>
                <namespace>http://www.w3.org/2001/XMLSchema</namespace>
            </type>
            <value/>
        </namedTypedValue>
        <preferredEditor>legacy</preferredEditor>
        <offlineEnabled>false</offlineEnabled>
    </rule>
