    <rule>
        <name>PE_SFTP_returnFullFiles</name>
        <uuid>_a-0000ed1c-537a-8000-9c62-011c48011c48_13698598</uuid>
        <description>Expression to filter out PS_PERSONAL_FULL and PS_FULL_OUTSIDERS file</description>
        <parentUuid>29a5d1a0-0cee-4539-9a25-a36937648dd0</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>reject(
  #"_a-0000eb38-82c9-8000-9c51-011c48011c48_12461260",
  #"SYSTEM_SYSRULES_forEach"(
  items:ri!todaysFiles,
  expression: {
    if(
      and(
        search("APPIANCAW_PSPERSONAL", fv!item) = 0,
        search("APPIANCAW_PSOUTSIDERS", fv!item) = 0
      ),
      fv!item,
      {}
    )
    
  }
)
)</definition>
