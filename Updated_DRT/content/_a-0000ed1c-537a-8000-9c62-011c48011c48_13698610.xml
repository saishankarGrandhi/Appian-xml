        <name>PE_SFTP_returnIncrementalFiles</name>
        <uuid>_a-0000ed1c-537a-8000-9c62-011c48011c48_13698610</uuid>
        <description>Expression to filter out PS_PERSONAL and PS_OUTSIDERS file</description>
        <parentUuid>29a5d1a0-0cee-4539-9a25-a36937648dd0</parentUuid>
        <visibility>
            <advertise>false</advertise>
            <hierarchy>true</hierarchy>
            <indexable>true</indexable>
            <quota>false</quota>
            <searchable>true</searchable>
            <system>false</system>
            <unlogged>false</unlogged>
        </visibility>
        <definition>reject(
  #"_a-0000eb38-82c9-8000-9c51-011c48011c48_12461260",
  #"SYSTEM_SYSRULES_forEach"(
    items: ri!todaysFiles,
    expression: {
      if(
        or(
          search("APPIANCAW_PSPERSONAL", fv!item) = 1,
          search("APPIANCAW_PSOUTSIDERS", fv!item) = 1,
          
        ),
        fv!item,
        {}
      )
    }
  )
)</definition>
